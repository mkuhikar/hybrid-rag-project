# Copy to .env or export through your deployment's secret manager.
GROQ_API_KEY=

# AWS ingestion pipeline
AWS_REGION=us-east-1
DOCUMENT_BUCKET=
SQS_QUEUE_URL=

# Local development persistence. Use managed Postgres/vector storage in production.
RAG_DATABASE_PATH=data/rag.db
APPLICATION_DATABASE_PATH=data/application.db

# Optional application settings
LOG_LEVEL=INFO
LOG_DIR=logs
